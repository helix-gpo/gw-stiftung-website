        <h3 class="spenden-card-title">Jetzt spenden</h3>
        <div class="spenden-bank-block">
          <div class="spenden-bank-header">
            <app-icon
              [iconName]="'account_balance'"
              [iconColor]="'#c9963a'"
              [iconSize]="'2rem'"
            ></app-icon>
            <span>Bankverbindung</span>
          </div>
          <div class="spenden-bank-details">
            <p><strong>Bank:</strong> Kreissparkasse Düsseldorf</p>
            <p><strong>IBAN:</strong> DE89 3245 0000 0000 0000 00</p>
            <p><strong>BIC:</strong> WELADED1DUE</p>
            <p><strong>Empfänger:</strong> Geschwister Weiß-Stiftung</p>
          </div>
        </div>
        <button class="btn-gold-full" (click)="handleSpenden()">
          <app-icon [iconName]="'mail'" [iconColor]="'#1a2d42'" [iconSize]="'2rem'"></app-icon>
          Kontakt aufnehmen
        </button>
        <p class="spenden-card-hint">Für Fragen zur Spende kontaktieren Sie uns gerne.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== KONTAKT ===================== -->
<section class="kontakt-section" id="kontakt">
  <div class="kontakt-container">
    <div class="section-header">
      <div class="section-overhead centered">
        <span class="overhead-line"></span>
        <span class="overhead-label">KONTAKT</span>
        <span class="overhead-line"></span>
      </div>
      <h2 class="section-title">Wir freuen uns auf Sie</h2>
      <p class="section-subtitle">
        Haben Sie Fragen oder möchten Sie mehr über unsere Arbeit erfahren? Schreiben Sie uns.
      </p>
    </div>

    <div class="kontakt-grid">
      <!-- Form -->
      <div class="kontakt-form-card">
        <h3 class="kontakt-form-title">Nachricht senden</h3>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Name *</label>
            <input
              class="form-input"
              type="text"
              placeholder="Ihr vollständiger Name"
              [(ngModel)]="formData.name"
            />
          </div>
          <div class="form-group">
            <label class="form-label">E-Mail *</label>
            <input
              class="form-input"
              type="email"
              placeholder="ihre.email&#64;beispiel.de"
              [(ngModel)]="formData.email"
            />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Betreff</label>
          <select class="form-select" [(ngModel)]="formData.betreff">
            <option value="">Bitte wählen</option>
            <option value="Allgemeine Anfrage">Allgemeine Anfrage</option>
            <option value="Spendenanfrage">Spendenanfrage</option>
            <option value="Projektanfrage">Projektanfrage</option>
            <option value="Presse">Presse</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Nachricht *</label>
          <textarea
            class="form-textarea"
            placeholder="Wie können wir Ihnen helfen?"
            [(ngModel)]="formData.nachricht"
            rows="5"
          ></textarea>
        </div>
        <div class="form-checkbox-row">
          <input type="checkbox" id="datenschutz" [(ngModel)]="formData.datenschutz" />
          <label for="datenschutz" class="form-checkbox-label">
            Ich habe die
            <a class="form-link" (click)="routing('datenschutz')">Datenschutzerklärung</a> gelesen
            und akzeptiere diese. *
          </label>
        </div>
        <button class="btn-dark-full" (click)="handleContactSubmit()">
          Nachricht senden
          <app-icon [iconName]="'send'" [iconColor]="'#ffffff'" [iconSize]="'1.8rem'"></app-icon>
        </button>
      </div>

      <!-- Contact Info -->
      <div class="kontakt-info-col">
        <div class="kontakt-info-card">
          <app-icon
            [iconName]="'location_on'"
            [iconColor]="'#c9963a'"
            [iconSize]="'2.4rem'"
          ></app-icon>
          <div>
            <p class="kontakt-info-title">Adresse</p>
            <p class="kontakt-info-text">Geschwister Weiß-Stiftung</p>
            <p class="kontakt-info-text">Musterstraße 1</p>
            <p class="kontakt-info-text">41460 Neuss</p>
            <p class="kontakt-info-text">Deutschland</p>
          </div>
        </div>
        <div class="kontakt-info-card">
          <app-icon [iconName]="'mail'" [iconColor]="'#c9963a'" [iconSize]="'2.4rem'"></app-icon>
          <div>
            <p class="kontakt-info-title">E-Mail</p>
            <a href="mailto:info@geschwister-weiss-stiftung.de" class="kontakt-info-link">
              info&#64;geschwister-weiss-stiftung.de
            </a>
          </div>
        </div>
        <div class="kontakt-info-card kontakt-info-card--dark">
          <app-icon
            [iconName]="'schedule'"
            [iconColor]="'#c9963a'"
            [iconSize]="'2.4rem'"
          ></app-icon>
          <div>
            <p class="kontakt-info-title kontakt-info-title--light">Erreichbarkeit</p>
            <p class="kontakt-info-text--light">Montag – Freitag: 9:00 – 17:00 Uhr</p>
            <p class="kontakt-info-text--light">Wochenende: Nach Vereinbarung</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</file>

<file path="src/app/pages/main/main.scss">
@use '../../../styles' as *;

// =====================
// SHARED SECTION STYLES
// =====================

.section-overhead {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 1.6rem;

  &.centered {
    justify-content: center;
  }
}

.overhead-line {
  flex: 0 0 3.2rem;
  height: 2px;
  background-color: var(--accent-gold);
}

.overhead-label {
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  color: var(--accent-gold);
}

.section-header {
  text-align: center;
  margin-bottom: 6.4rem;
}

.section-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 1.6rem;
  line-height: 1.2;

  @include respond(sm) {
    font-size: 3rem;
  }
}

.section-subtitle {
  font-size: 1.6rem;
  color: var(--text-grey);
  line-height: 1.6;
  max-width: 56rem;
  margin: 0 auto;
}

.highlight {
  color: var(--accent-gold);
}

.highlight-gold {
  color: var(--accent-gold) !important;
}

// =====================
// HERO
// =====================

.hero-section {
  position: relative;
  width: 100%;
  min-height: calc(100vh - 7.2rem);
  overflow: hidden;
  display: flex;
  align-items: center;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('/images/hero.png');
  background-size: cover;
  background-position: center;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(15, 28, 45, 0.92) 0%,
    rgba(15, 28, 45, 0.85) 35%,
    rgba(15, 28, 45, 0.55) 65%,
    rgba(15, 28, 45, 0.1) 100%
  );
  z-index: 1;
}

.hero-container {
  @include container;
  position: relative;
  z-index: 2;
  padding-top: 8rem;
  padding-bottom: 8rem;
}

.hero-content {
  max-width: 64rem;
  @include flex-col(0);
}

.hero-line {
  width: 4rem;
  height: 3px;
  background-color: var(--accent-gold);
  margin-bottom: 2.8rem;
}

.hero-title {
  font-size: 6rem;
  font-weight: 700;
  color: var(--text-light);
  line-height: 1.1;
  margin-bottom: 2.4rem;

  @include respond(md) {
    font-size: 4.4rem;
  }
  @include respond(sm) {
    font-size: 3.4rem;
  }
}

.hero-description {
  font-size: 1.7rem;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  max-width: 50rem;
  margin-bottom: 4rem;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 1.6rem;
  margin-bottom: 4.8rem;

  @include respond(sm) {
    flex-direction: column;
    align-items: flex-start;
  }
}

.btn-gold {
  @include button-base;
  background-color: var(--accent-gold);
  color: var(--text-dark);
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(201, 150, 58, 0.4);

  &:hover {
    background-color: var(--accent-gold-hover);
    transform: translateY(-0.1rem);
  }
}

.btn-outline {
  @include button-base;
  background-color: transparent;
  color: var(--text-light);
  border: 2px solid rgba(255, 255, 255, 0.5);

  &:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.8);
  }
}

.hero-divider {
  width: 100%;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.15);
  margin-bottom: 3.2rem;
}

.hero-badges {
  display: flex;
  gap: 3.2rem;
  flex-wrap: wrap;
}

.hero-badge-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1.4rem;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.hero-scroll-hint {
  position: absolute;
  bottom: 3.2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  animation: bounce 2s infinite;
  opacity: 0.7;
}

@keyframes bounce {
  0%,
  100% {
    transform: translateX(-50%) translateY(0);
  }
  50% {
    transform: translateX(-50%) translateY(0.8rem);
  }
}

// =====================
// ABOUT
// =====================

.about-section {
  background-color: var(--bg-white);
  padding: 12rem 0;
}

.about-container {
  @include container;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9.6rem;
  align-items: center;

  @include respond(md) {
    grid-template-columns: 1fr;
    gap: 5.6rem;
  }
}

.about-image-col {
  position: relative;
}

.about-img-wrapper {
  position: relative;
  border-radius: 1.6rem;
  overflow: visible;
}

.about-img {
  width: 100%;
  height: auto;
  border-radius: 1.6rem;
  box-shadow: var(--shadow-lg);
  display: block;
}

.about-img-badge {
  position: absolute;
  bottom: -2.4rem;
  left: -2.4rem;
  background-color: var(--bg-white);
  border-radius: 1.2rem;
  padding: 2rem 2.8rem;
  box-shadow: var(--shadow-md);

  @include respond(md) {
    bottom: 2rem;
    left: 2rem;
  }
}

.badge-year {
  font-size: 3.2rem;
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1;
}

.badge-text {
  font-size: 1.3rem;
  color: var(--text-grey);
  margin-top: 0.4rem;
}

.about-text-col {
  @include flex-col(0);
}

.about-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.2;
  margin-bottom: 2.4rem;

  @include respond(sm) {
    font-size: 3rem;
  }
}

.about-description {
  font-size: 1.5rem;
  color: var(--text-grey);
  line-height: 1.7;
  margin-bottom: 1.6rem;

  strong {
    color: var(--text-dark);
  }
}

.about-values-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin: 3.2rem 0;
}

.about-value-item {
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
}

.value-title {
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 0.3rem;
}

.value-sub {
  font-size: 1.3rem;
  color: var(--text-grey);
}

.about-quote {
  border-left: 3px solid var(--accent-gold);
  padding-left: 2rem;
  margin-top: 0.8rem;

  p {
    font-size: 1.6rem;
    font-style: italic;
    color: var(--text-grey);
    line-height: 1.6;
    margin-bottom: 0.8rem;
  }

  cite {
    font-size: 1.3rem;
    color: var(--text-grey);
    font-style: normal;
  }
}

// =====================
// MISSION
// =====================

.mission-section {
  background-color: var(--bg-light);
  padding: 12rem 0;
}

.mission-container {
  @include container;
}

.mission-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.2rem;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.mission-card {
  position: relative;
  border-radius: 2rem;
  padding: 4rem;
  overflow: hidden;
  @include flex-col(2.4rem);
}

.mission-card--blue {
  background-color: var(--primary-blue);
  color: var(--text-light);
}

.mission-card--gold {
  background: linear-gradient(135deg, #b5802a 0%, #8a6020 40%, #6a7a8a 100%);
  color: var(--text-light);
}

.mission-card-icon {
  width: 5.2rem;
  height: 5.2rem;
  border-radius: 1.2rem;
  background-color: rgba(255, 255, 255, 0.12);
  @include flex-center;
}

.mission-card-icon--light {
  background-color: rgba(255, 255, 255, 0.2);
}

.mission-card-title {
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--text-light);
}

.mission-card-text {
  font-size: 1.5rem;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.7;
}

.mission-card-list {
  list-style: none;
  @include flex-col(1.2rem);

  li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.85);
  }
}

.mission-card-watermark {
  position: absolute;
  bottom: -1.6rem;
  right: -1.6rem;
  pointer-events: none;
}

// =====================
// PROJEKTE
// =====================

.projekte-section {
  background-color: var(--bg-white);
  padding: 12rem 0;
}

.projekte-container {
  @include container;
}

.projekt-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background-color: var(--primary-blue);
  border-radius: 2rem;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  margin-bottom: 6.4rem;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.projekt-featured-img {
  position: relative;
  min-height: 32rem;
  overflow: hidden;

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
}

.projekt-badge {
  position: absolute;
  top: 2rem;
  left: 2rem;
  background-color: var(--accent-gold);
  color: var(--text-dark);
  font-size: 1.3rem;
  font-weight: 600;
  padding: 0.6rem 1.4rem;
  border-radius: 50rem;
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.projekt-badge-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  background-color: var(--text-dark);
}

.projekt-featured-body {
  padding: 4rem;
  @include flex-col(2.4rem);
  justify-content: center;
}

.projekt-featured-title {
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--text-light);
}

.projekt-featured-text {
  font-size: 1.5rem;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.7;
}

.projekt-featured-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.6rem;
}

.projekt-stat {
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 1rem;
  padding: 1.6rem 2rem;
}

.projekt-stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--text-light);
  margin-bottom: 0.4rem;
}

.projekt-stat-label {
  font-size: 1.3rem;
  color: rgba(255, 255, 255, 0.55);
}

.btn-gold-outline {
  @include button-base;
  background-color: var(--accent-gold);
  color: var(--text-dark);
  font-weight: 600;
  width: fit-content;

  &:hover {
    background-color: var(--accent-gold-hover);
  }
}

.projekte-sub-title {
  font-size: 2rem;
  font-weight: 600;
  color: var(--text-dark);
  text-align: center;
  margin-bottom: 3.2rem;
}

.projekte-future-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.4rem;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.projekte-future-card {
  background-color: var(--bg-light);
  border-radius: 1.2rem;
  padding: 3.2rem 2.8rem;
  @include flex-col(1.6rem);
  align-items: center;
  text-align: center;
  border: 1px solid var(--border-color);
  transition:
    box-shadow 0.3s,
    transform 0.3s;

  &:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-0.2rem);
  }
}

.future-card-title {
  font-size: 1.6rem;
  font-weight: 600;
  color: var(--text-dark);
}

.future-card-text {
  font-size: 1.4rem;
  color: var(--text-grey);
  line-height: 1.6;
}

// =====================
// SPENDEN
// =====================

.spenden-section {
  background-color: var(--bg-dark);
  padding: 12rem 0;
  position: relative;

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle at 20% 50%,
      rgba(201, 150, 58, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
}

.spenden-container {
  @include container;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rem;
  align-items: center;

  @include respond(md) {
    grid-template-columns: 1fr;
    gap: 5.6rem;
  }
}

.spenden-left {
  @include flex-col(2.8rem);
}

.spenden-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--text-light);
  line-height: 1.2;

  @include respond(sm) {
    font-size: 3rem;
  }
}

.spenden-description {
  font-size: 1.6rem;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.7;
  max-width: 48rem;
}

.spenden-list {
  list-style: none;
  @include flex-col(1.6rem);

  li {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.75);
  }
}

.spenden-card {
  background-color: var(--bg-white);
  border-radius: 2rem;
  padding: 4rem;
  box-shadow: var(--shadow-lg);
  @include flex-col(2.4rem);
}

.spenden-card-title {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--text-dark);
  text-align: center;
}

.spenden-bank-block {
  background-color: var(--bg-light);
  border-radius: 1.2rem;
  padding: 2.4rem;
  @include flex-col(1.6rem);
}

.spenden-bank-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 1.6rem;
  font-weight: 600;
  color: var(--text-dark);
  padding-bottom: 1.2rem;
  border-bottom: 1px solid var(--border-color);
}

.spenden-bank-details {
  @include flex-col(0.8rem);

  p {
    font-size: 1.4rem;
    color: var(--text-grey);

    strong {
      color: var(--text-dark);
    }
  }
}

.btn-gold-full {
  @include button-base;
  background-color: var(--accent-gold);
  color: var(--text-dark);
  font-weight: 600;
  width: 100%;
  justify-content: center;
  font-size: 1.7rem;

  &:hover {
    background-color: var(--accent-gold-hover);
  }
}

.spenden-card-hint {
  font-size: 1.3rem;
  color: var(--text-grey);
  text-align: center;
}

// =====================
// KONTAKT
// =====================

.kontakt-section {
  background-color: var(--bg-light);
  padding: 12rem 0;
}

.kontakt-container {
  @include container;
}

.kontakt-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 3.2rem;
  align-items: start;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.kontakt-form-card {
  background-color: var(--bg-white);
  border-radius: 1.6rem;
  padding: 4rem;
  box-shadow: var(--shadow-md);
  @include flex-col(2rem);
}

.kontakt-form-title {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--text-dark);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.6rem;

  @include respond(sm) {
    grid-template-columns: 1fr;
  }
}

.form-group {
  @include flex-col(0.8rem);
}

.form-label {
  font-size: 1.4rem;
  font-weight: 500;
  color: var(--text-dark);
}

.form-input,
.form-select,
.form-textarea {
  font-family: inherit;
  font-size: 1.5rem;
  color: var(--text-dark);
  background-color: var(--bg-white);
  border: 1.5px solid var(--border-color);
  border-radius: 0.8rem;
  padding: 1.2rem 1.6rem;
  width: 100%;
  transition: border-color 0.2s;
  outline: none;

  &:focus {
    border-color: var(--primary-blue);
  }

  &::placeholder {
    color: var(--text-muted);
  }
}

.form-textarea {
  resize: vertical;
  min-height: 12rem;
}

.form-checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;

  input[type='checkbox'] {
