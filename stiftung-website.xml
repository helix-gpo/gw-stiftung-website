      color: var(--accent-gold);
    }
  }
}

.footer-spenden-btn {
  @include button-base;
  background-color: var(--accent-gold);
  color: var(--text-dark);
  font-size: 1.4rem;
  padding: 1rem 2rem;
  margin-top: 2.4rem;

  &:hover {
    background-color: var(--accent-gold-hover);
  }
}

.footer-bottom {
  @include container;
  @include flex-between;
  padding-top: 2.4rem;
  padding-bottom: 3.2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  font-size: 1.3rem;
  color: var(--text-muted);

  @include respond(sm) {
    flex-direction: column;
    gap: 1.6rem;
    text-align: center;
  }
}

.footer-bottom-links {
  display: flex;
  gap: 2.4rem;

  button {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 1.3rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s;

    &:hover {
      color: var(--text-light);
    }
  }
}
