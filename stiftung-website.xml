@use '@angular/material' as mat;

// =====================
// MIXINS
// =====================

@mixin respond($breakpoint) {
  @if $breakpoint == xl {
    @media (max-width: 75em) {
      @content;
    }
  }
  @if $breakpoint == lg {
    @media (max-width: 64em) {
      @content;
    }
  }
  @if $breakpoint == md {
    @media (max-width: 52em) {
      @content;
    }
  }
  @if $breakpoint == sm {
    @media (max-width: 36em) {
      @content;
    }
  }
  @if $breakpoint == xs {
    @media (max-width: 27em) {
      @content;
    }
  }
}

@mixin flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

@mixin flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

@mixin flex-col($gap: 0) {
  display: flex;
  flex-direction: column;
  @if $gap > 0 {
    gap: $gap;
  }
}

@mixin container {
  max-width: 120rem;
  padding: 0 3.2rem;
  margin: 0 auto;
  width: 100%;
}

@mixin button-base {
  font-family: inherit;
  font-size: 1.6rem;
  font-weight: 500;
  border: none;
  border-radius: 0.8rem;
  cursor: pointer;
  transition: all 0.3s;
  padding: 1.4rem 2.4rem;
  @include flex-center;
  gap: 0.8rem;
}

// =====================
// RESET & BASE
// =====================

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  height: 100%;
  font-size: 62.5%;
  overflow-x: hidden;
  scroll-behavior: smooth;

  @include mat.theme(
    (
      color: (
        primary: mat.$azure-palette,
        tertiary: mat.$blue-palette,
      ),
      typography: Roboto,
      density: 0,
    )
  );

  @include respond(xl) {
    font-size: 56.25%;
  }
  @include respond(lg) {
    font-size: 50%;
  }
  @include respond(xs) {
    font-size: 40%;
  }
}

body {
  color-scheme: light;
  background-color: #ffffff;
  font-family: 'Rubik', sans-serif;
  line-height: 1;
  font-weight: 400;
  color: var(--text-dark);
  margin: 0;
  height: 100%;
  overflow-x: hidden;
}

// =====================
// CSS VARIABLES
// =====================

:root {
  --primary-blue: #1e3a5f;
  --primary-blue-hover: #2a4f7a;
  --primary-blue-active: #162d4a;
  --primary-blue-light: #eef3f8;

  --accent-gold: #c9963a;
  --accent-gold-hover: #d9a84a;
  --accent-gold-active: #b8852e;
  --accent-gold-light: #fdf6e9;

  --bg-white: #ffffff;
  --bg-light: #f0f2f5;
  --bg-dark: #1a2d42;
  --bg-dark-2: #243650;

  --text-dark: #1a2d42;
  --text-grey: #5a6a7a;
  --text-light: #ffffff;
  --text-muted: #8a9ab0;

  --border-color: #d5dde5;
  --shadow-sm: 0 0.1rem 0.4rem rgba(0, 0, 0, 0.07);
  --shadow-md: 0 0.4rem 1.6rem rgba(0, 0, 0, 0.1);
